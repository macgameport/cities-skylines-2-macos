# winemac: implement cross-process CHILD window Metal swapchains (wine 11.11+)
#
# Applies to dlls/winemac.drv/ of a wine tree that already carries the aquadran DXMT
# support patch (scripts/wineandaqua-dxmt.patch). Requires wine >= 11.11: the
# macdrv_client_surface_acquire_metal_swapchain / CAContext / CALayerHost route this
# builds on landed in 11.11 (absent in 11.0 and 11.10 — verified against wine git tags).
#
# WHAT IT FIXES
# Steam's CEF presents into an HWND owned by ANOTHER process, and that HWND is a CHILD
# window. winemac already implements the cross-process route for ROOT windows (offscreen
# CAMetalLayer exported as a CAContext, hosted by the owner via CALayerHost) but bails on
# children:
#     if (NtUserGetAncestor(hwnd, GA_ROOT) != hwnd) {
#         FIXME("Cross-process child window Metal swapchains are not implemented\n");
#         return FALSE;
#     }
# Result: Steam's client window is uniformly black on stock winemac + DXMT.
#
# WHAT IT DOES
#  1. window.c  — for a foreign CHILD hwnd, build the CAContextSwapChain against its ROOT.
#     macdrv_create_offscreen_swapchain() posts WM_MACDRV_CREATE_REMOTE_LAYER to whichever
#     hwnd it is given, and that handler needs data->cocoa_window — which a child does not
#     have. The root both owns an NSWindow and lives in the owning process.
#  2. window.c  — carry the child hwnd in wParam (0 for a root) so the owner can position
#     the hosted layer, and compute its rect there as GetWindowRect(child) - GetWindowRect(root).
#  3. cocoa_window.m — addCALayerHostViewWithContextId:frame: positions and clips the host
#     to that rect instead of stretching every host over the whole content view. Without
#     this, sibling widgets occlude each other and only the topmost is ever visible.
#     WineContentView is isFlipped=YES, so Windows' top-left origin maps through directly.
#  4. macdrv_main.c — add dxmt_acquire_remote_layer() to macdrv_functions_t so a Metal
#     layer can reach this route at all. Today its ONLY caller is vulkan.c; the DXMT-facing
#     ABI could not see it. ⚠ This changes sizeof(struct macdrv_functions_t) 80 -> 88, so
#     the Metal layer must be rebuilt in lockstep.
#
# MEASURED (M3 Max, macOS 26.6.2, self-built stock wine 11.16 + DXMT):
#   before: Steam window 108,343 B, uniformly black
#   after:  2,588,759 B, store renders — no shim, no injected flags, out-of-process GPU
#   child path fires 46x per launch, zero acquire_metal_swapchain failures
#
# ⚠ KNOWN INCOMPLETE — do not treat as finished:
#   * The hosted layer is positioned only at creation. A widget that moves or resizes
#     afterwards keeps a stale frame; it should be repositioned on WM_MACDRV_WINDOWPOSCHANGED.
#   * Many child rects are 0x0 at swapchain-creation time (widget not yet laid out) and
#     fall back to full bounds, so the mapping is not exercised for them.
#   * Glyphs are still missing in this configuration. That is a SEPARATE defect —
#     in-process GPU loses text on every engine tested, while CPU raster
#     (--disable-gpu --single-process) renders text fine on an 11.0-lineage engine.
#
diff -urN a/dlls/winemac.drv/cocoa_window.m b/dlls/winemac.drv/cocoa_window.m
--- a/dlls/winemac.drv/cocoa_window.m	2026-08-30 03:35:46
+++ b/dlls/winemac.drv/cocoa_window.m	2026-08-30 03:36:18
@@ -725,7 +725,7 @@
         return _metalView;
     }
 
-    - (void) addCALayerHostViewWithContextId:(CAContextID)contextId
+    - (void) addCALayerHostViewWithContextId:(CAContextID)contextId frame:(CGRect)frame
     {
         if (!_caLayerHosts)
             _caLayerHosts = [[NSMutableDictionary alloc] init];
@@ -736,8 +736,20 @@
         [host setContextId:contextId];
         host.magnificationFilter = kCAFilterNearest;
         host.contentsScale = retina_on ? 2.0 : 1.0;
-        host.frame = self.layer.bounds;
-        host.autoresizingMask = kCALayerWidthSizable | kCALayerHeightSizable;
+        /* EXPERIMENT (2026-08-29, macgameport): every host used to be stretched to the whole
+         * content view, so with several hosts on one window only the topmost was ever visible
+         * (measured: bottom-insertion => black). When a real child rect is supplied, position and
+         * clip the host to it instead, so sibling widgets stop occluding one another. */
+        if (!CGRectIsEmpty(frame))
+        {
+            host.frame = frame;
+            host.masksToBounds = YES;
+        }
+        else
+        {
+            host.frame = self.layer.bounds;
+            host.autoresizingMask = kCALayerWidthSizable | kCALayerHeightSizable;
+        }
 
         [self.layer addSublayer:host];
         [_caLayerHosts setObject:host forKey:@(contextId)];
@@ -4083,24 +4095,26 @@
 @interface CAContextSwapChain : NSObject <WineMetalSwapChain>
 {
     void* hwnd;
+    void* child_hwnd;          /* the cross-process child this layer belongs to (may be NULL) */
     macdrv_metal_device device;
     CAMetalLayer* offscreen_layer;
     CAContext* remote_context;
     CAContextID context_id;
 }
 
-- (instancetype) initWithHwnd:(void*)hwnd bounds:(CGRect)bounds;
+- (instancetype) initWithHwnd:(void*)hwnd child:(void*)child bounds:(CGRect)bounds;
 
 @end
 
 @implementation CAContextSwapChain
 
-- (instancetype) initWithHwnd:(void*)newHwnd bounds:(CGRect)bounds
+- (instancetype) initWithHwnd:(void*)newHwnd child:(void*)newChild bounds:(CGRect)bounds
 {
     self = [super init];
     if (!self) return nil;
 
     hwnd = newHwnd;
+    child_hwnd = newChild;
     if (!(device = macdrv_create_metal_device()))
     {
         [self release];
@@ -4139,7 +4153,7 @@
         return nil;
     }
 
-    macdrv_create_remote_layer(hwnd, context_id);
+    macdrv_create_remote_layer(hwnd, child_hwnd, context_id);
     return self;
 }
 
@@ -4172,9 +4186,9 @@
     return (macdrv_metal_swapchain)[[MetalViewSwapChain alloc] initWithView:v];
 }
 
-macdrv_metal_swapchain macdrv_create_offscreen_swapchain(void* hwnd, CGRect bounds)
+macdrv_metal_swapchain macdrv_create_offscreen_swapchain(void* hwnd, void* child, CGRect bounds)
 {
-    return (macdrv_metal_swapchain)[[CAContextSwapChain alloc] initWithHwnd:hwnd bounds:bounds];
+    return (macdrv_metal_swapchain)[[CAContextSwapChain alloc] initWithHwnd:hwnd child:child bounds:bounds];
 }
 
 macdrv_metal_layer macdrv_swapchain_get_layer(macdrv_metal_swapchain swapchain)
@@ -4188,7 +4202,7 @@
     [(id<WineMetalSwapChain>)swapchain release];
 }
 
-void macdrv_window_create_ca_layer_host_view(macdrv_window w, unsigned int context_id)
+void macdrv_window_create_ca_layer_host_view(macdrv_window w, unsigned int context_id, CGRect frame)
 {
 @autoreleasepool
 {
@@ -4198,7 +4212,7 @@
         NSView* content_view = [window contentView];
 
         if ([content_view isKindOfClass:[WineContentView class]])
-            [(WineContentView*)content_view addCALayerHostViewWithContextId:context_id];
+            [(WineContentView*)content_view addCALayerHostViewWithContextId:context_id frame:frame];
     });
 }
 }
diff -urN a/dlls/winemac.drv/macdrv_cocoa.h b/dlls/winemac.drv/macdrv_cocoa.h
--- a/dlls/winemac.drv/macdrv_cocoa.h	2026-08-30 03:35:46
+++ b/dlls/winemac.drv/macdrv_cocoa.h	2026-08-30 00:18:15
@@ -533,12 +533,12 @@
