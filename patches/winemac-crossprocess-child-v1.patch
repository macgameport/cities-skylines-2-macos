diff -urN a/dlls/winemac.drv/macdrv_main.c b/dlls/winemac.drv/macdrv_main.c
--- a/dlls/winemac.drv/macdrv_main.c	2026-08-30 03:35:46
+++ b/dlls/winemac.drv/macdrv_main.c	2026-08-30 03:36:41
@@ -652,8 +652,13 @@
     macdrv_metal_layer (*macdrv_view_get_metal_layer)(macdrv_metal_view v);
     void (*macdrv_view_release_metal_view)(macdrv_metal_view v);
     void (*on_main_thread)(dispatch_block_t b);
+    /* EXPERIMENT (2026-08-29, macgameport): gives DXMT the CAContext-backed offscreen layer
+     * for a FOREIGN hwnd, i.e. the cross-process route wine already implements and today
+     * only vulkan.c reaches. Returns the layer; *ret_view gets the client surface's view so
+     * DXMT's non-NULL assert is satisfied. */
+    macdrv_metal_layer (*dxmt_acquire_remote_layer)(HWND hwnd, macdrv_view *ret_view);
 };
-C_ASSERT(sizeof(struct macdrv_functions_t) == 80);
+C_ASSERT(sizeof(struct macdrv_functions_t) == 88);
 
 struct dxmt_macdrv_win_data
 {
@@ -768,6 +773,53 @@
     return macdrv_view_release_metal_view(v);
 }
 
+/* One hosted remote layer per HWND. Without this the surfaces leak, every retry adds another
+ * CALayerHost to the same content view, and a stale layer can sit on top of the live one --
+ * which looks exactly like "renders art but no text". Measured 2026-08-29: the main Steam
+ * window acquired SEVEN layers in one session. */
+static pthread_mutex_t remote_layer_mutex = PTHREAD_MUTEX_INITIALIZER;
+static CFMutableDictionaryRef remote_layer_surfaces;
+
+static macdrv_metal_layer my_dxmt_acquire_remote_layer(HWND hwnd, macdrv_view *ret_view)
+{
+    struct client_surface *client;
+    struct macdrv_client_surface *surface;
+    struct client_surface *previous = NULL;
+
+    if (ret_view) *ret_view = NULL;
+    if (!(client = macdrv_CreateClientSurface(hwnd, 0))) return NULL;
+    surface = impl_from_client_surface(client);
+
+    if (!macdrv_client_surface_acquire_metal_swapchain(surface))
+    {
+        ERR("dxmt: acquire_metal_swapchain FAILED for hwnd %p\n", hwnd);
+        client_surface_release(client);
+        return NULL;
+    }
+
+    ERR("dxmt: remote layer acquired for hwnd %p (swapchain %p)\n", hwnd, surface->metal_swapchain);
+    if (ret_view) *ret_view = surface->cocoa_view;
+
+    /* Retire any previous surface for this HWND so exactly one CALayerHost stays hosted.
+     * Releasing it deallocs the CAContextSwapChain, which posts WM_MACDRV_RELEASE_REMOTE_LAYER. */
+    pthread_mutex_lock(&remote_layer_mutex);
+    if (!remote_layer_surfaces)
+        remote_layer_surfaces = CFDictionaryCreateMutable(NULL, 0, NULL, NULL);
+    if (remote_layer_surfaces)
+    {
+        previous = (struct client_surface *)CFDictionaryGetValue(remote_layer_surfaces, hwnd);
+        CFDictionarySetValue(remote_layer_surfaces, hwnd, client);
+    }
+    pthread_mutex_unlock(&remote_layer_mutex);
+    /* ⚠ DO NOT release `previous` here. Measured 2026-08-29: DXMT keeps rendering into the
+     * layer it was handed by an earlier acquire, so releasing on the next acquire destroys the
+     * live layer and the window goes straight back to BLACK (108,343 B). The leak is
+     * load-bearing until lifetime is driven by DXMT releasing its swapchain. */
+    (void)previous;
+
+    return macdrv_swapchain_get_layer(surface->metal_swapchain);
+}
+
 DECLSPEC_EXPORT struct macdrv_functions_t macdrv_functions =
 {
     &my_macdrv_init_display_devices,
@@ -779,7 +831,8 @@
     &my_macdrv_view_create_metal_view,
     &my_macdrv_view_get_metal_layer,
     &my_macdrv_view_release_metal_view,
-    NULL
+    NULL,
+    &my_dxmt_acquire_remote_layer
 };
 
 void macdrv_client_surface_presented(const macdrv_event *event)
diff -urN a/dlls/winemac.drv/window.c b/dlls/winemac.drv/window.c
--- a/dlls/winemac.drv/window.c	2026-08-30 03:35:46
+++ b/dlls/winemac.drv/window.c	2026-08-30 03:36:18
@@ -1178,14 +1178,24 @@
     {
         RECT rect;
 
-        if (NtUserGetAncestor(hwnd, GA_ROOT) != hwnd)
-        {
-            FIXME("Cross-process child window Metal swapchains are not implemented\n");
-            return FALSE;
-        }
+        HWND root = NtUserGetAncestor(hwnd, GA_ROOT);
 
         if (!NtUserGetClientRect(hwnd, &rect, NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI))) return FALSE;
-        surface->metal_swapchain = macdrv_create_offscreen_swapchain(hwnd, cgrect_from_rect(rect));
+
+        if (root && root != hwnd)
+        {
+            /* EXPERIMENT (2026-08-29, macgameport): cross-process CHILD window. The root-window
+             * path below already exports a CAContext and posts WM_MACDRV_CREATE_REMOTE_LAYER to
+             * the HWND's owner, which hosts it via CALayerHost. A child HWND has no cocoa_window
+             * of its own, so the message must go to its ROOT instead -- that is the window which
+             * both owns an NSWindow and lives in the other process. Geometry is not mapped yet:
+             * the hosted layer fills the root's content view, which is approximately right when
+             * the child covers the client area (CEF's main widget does). */
+            ERR("dxmt: cross-process CHILD hwnd %p -> hosting remote layer on root %p\n", hwnd, root);
+            surface->metal_swapchain = macdrv_create_offscreen_swapchain(root, hwnd, cgrect_from_rect(rect));
+        }
+        else
+            surface->metal_swapchain = macdrv_create_offscreen_swapchain(hwnd, NULL, cgrect_from_rect(rect));
     }
 
     return surface->metal_swapchain != NULL;
@@ -1560,8 +1570,25 @@
     case WM_MACDRV_CREATE_REMOTE_LAYER:
         if ((data = get_win_data(hwnd)))
         {
-            TRACE("WM_MACDRV_CREATE_REMOTE_LAYER context_id %u\n", (unsigned int)lp);
-            if (data->cocoa_window) macdrv_window_create_ca_layer_host_view(data->cocoa_window, (unsigned int)lp);
+            HWND child = (HWND)wp;
+            CGRect frame = CGRectNull;
+
+            TRACE("WM_MACDRV_CREATE_REMOTE_LAYER child %p context_id %u\n", child, (unsigned int)lp);
+            if (child)
+            {
+                UINT dpi = NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI);
+                RECT cr, rr;
+
+                if (NtUserGetWindowRect(child, &cr, dpi) && NtUserGetWindowRect(hwnd, &rr, dpi))
+                {
+                    OffsetRect(&cr, -rr.left, -rr.top);
+                    frame = CGRectMake(cr.left, cr.top, cr.right - cr.left, cr.bottom - cr.top);
+                    ERR("dxmt: child %p layer frame in root %p = %d,%d %dx%d\n", child, hwnd,
+                        (int)cr.left, (int)cr.top, (int)(cr.right - cr.left), (int)(cr.bottom - cr.top));
+                }
+            }
+            if (data->cocoa_window)
+                macdrv_window_create_ca_layer_host_view(data->cocoa_window, (unsigned int)lp, frame);
             release_win_data(data);
         }
         return 0;
@@ -1580,9 +1607,11 @@
 }
 
 
-void macdrv_create_remote_layer(void* hwnd_ptr, unsigned int context_id)
+void macdrv_create_remote_layer(void* hwnd_ptr, void* child_ptr, unsigned int context_id)
 {
-    NtUserPostMessage((HWND)hwnd_ptr, WM_MACDRV_CREATE_REMOTE_LAYER, 0, context_id);
+    /* wParam carries the cross-process CHILD hwnd (0 for a root window) so the owning process can
