# dxmt: reach winemac's cross-process CAContext route for a foreign HWND
#
# Companion to patches/winemac-crossprocess-child-v1.patch. Neither half works alone:
# the wine patch implements the route, this lets DXMT get to it.
#
# Against notpop/dxmt @ debug/present-path-tracing (924a607). Also needs
# scripts/dxmt-fork-iomanip.patch (a missing #include <iomanip> that current mingw-w64
# rejects) to build.
#
#  1. macdrv_functions_t gains dxmt_acquire_remote_layer(HWND, macdrv_view*), matching the
#     wine-side addition. ⚠ sizeof 80 -> 88: both sides must be rebuilt together.
#  2. _CreateMetalViewFromHWND() takes that route when macdrv_get_cocoa_window() returns
#     NULL — which is what happens for an HWND owned by another process, because macdrv's
#     win_datas is a process-local CFDictionary and a foreign window is simply not in it.
#  3. CreateSwapChain()'s cross-process guard returns E_FAIL BEFORE attempting anything, so
#     what actually breaks had never been observed. Env-gated here
#     (DXMT_ALLOW_CROSS_PROCESS_SWAPCHAIN=1) rather than removed, because it is still the
#     right refusal wherever the winemac route is absent — i.e. every wine < 11.11.
#     A shipping version should probe for the route instead of reading an env var.
#
diff --git a/src/d3d11/d3d11_swapchain.cpp b/src/d3d11/d3d11_swapchain.cpp
index 73c4203..366af8b 100644
--- a/src/d3d11/d3d11_swapchain.cpp
+++ b/src/d3d11/d3d11_swapchain.cpp
@@ -1099,8 +1099,15 @@ CreateSwapChain(
   DWORD window_process_id;
   GetWindowThreadProcessId(hWnd, &window_process_id);
   if (GetProcessId(GetCurrentProcess()) != window_process_id) {
-    ERR("CreateSwapChain: cross-process swapchain not supported yet");
-    return E_FAIL;
+    // EXPERIMENT (2026-08-29, macgameport): the guard below refuses BEFORE attempting anything,
+    // so what actually breaks cross-process has never been observed. Env-gated so the game path
+    // is untouched; set DXMT_ALLOW_CROSS_PROCESS_SWAPCHAIN=1 to fall through and find out.
+    if (env::getEnvVar("DXMT_ALLOW_CROSS_PROCESS_SWAPCHAIN") != "1") {
+      ERR("CreateSwapChain: cross-process swapchain not supported yet");
+      return E_FAIL;
+    }
+    ERR("CreateSwapChain: cross-process swapchain FORCED (experimental) hwnd_pid=", window_process_id,
+        " self_pid=", GetProcessId(GetCurrentProcess()));
   }
 
   Com<IMTLDXGIDevice> layer_factory;
diff --git a/src/util/com/com_guid.cpp b/src/util/com/com_guid.cpp
index 11bf4a7..05bda6c 100644
--- a/src/util/com/com_guid.cpp
+++ b/src/util/com/com_guid.cpp
@@ -8,6 +8,7 @@
  * See <https://github.com/doitsujin/dxvk/blob/master/LICENSE>
  */
 
+#include <iomanip>
 #include <mutex>
 #include <unordered_set>
 
diff --git a/src/winemetal/unix/winemetal_unix.c b/src/winemetal/unix/winemetal_unix.c
index 53a0341..c07aff6 100644
--- a/src/winemetal/unix/winemetal_unix.c
+++ b/src/winemetal/unix/winemetal_unix.c
@@ -1572,6 +1572,9 @@ struct macdrv_functions_t {
   macdrv_metal_layer (*macdrv_view_get_metal_layer)(macdrv_metal_view v);
   void (*macdrv_view_release_metal_view)(macdrv_metal_view v);
   void (*on_main_thread)(dispatch_block_t b);
+  /* EXPERIMENT (macgameport 2026-08-29): cross-process route. Wine already implements
+   * CAContext export + CALayerHost hosting; today only vulkan.c reaches it. */
+  macdrv_metal_layer (*dxmt_acquire_remote_layer)(HWND hwnd, macdrv_view *ret_view);
 };
 
 static NTSTATUS
@@ -1661,11 +1664,26 @@ _CreateMetalViewFromHWND(void *obj) {
   if (debug_metal_view)
     fprintf(stderr, "[dxmt/winemetal] CreateMetalViewFromHWND: cocoa_window=%p\n", (void *)window);
   if (!window) {
+    /* A NULL here usually means the HWND belongs to ANOTHER PROCESS: macdrv's win_datas is a
+     * process-local dictionary. Wine already implements the cross-process route (offscreen
+     * CAMetalLayer exported as a CAContext, hosted by the owner via CALayerHost) but only
+     * vulkan.c reaches it. Take it here when the engine exposes the accessor. */
+    if (macdrv_functions && macdrv_functions->dxmt_acquire_remote_layer) {
+      macdrv_view remote_view = NULL;
+      macdrv_metal_layer remote_layer =
+          macdrv_functions->dxmt_acquire_remote_layer(hwnd, &remote_view);
+      fprintf(stderr,
+              "[dxmt/winemetal] CreateMetalViewFromHWND: REMOTE path hwnd=%p layer=%p view=%p\n",
+              (void *)(uintptr_t)params->hwnd, (void *)remote_layer, (void *)remote_view);
+      if (remote_layer) {
+        params->ret_view = (obj_handle_t)remote_view;
+        params->ret_layer = (obj_handle_t)remote_layer;
+        return STATUS_SUCCESS;
+      }
+    }
     fprintf(stderr,
             "[dxmt/winemetal] CreateMetalViewFromHWND: macdrv_get_cocoa_window "
-            "returned NULL for hwnd=%p. The window is probably still in the "
-            "middle of being created; the caller will retry on the next "
-            "swapchain use.\n",
+            "returned NULL for hwnd=%p and no remote-layer route was available.\n",
             (void *)(uintptr_t)params->hwnd);
     return STATUS_SUCCESS;
   }
