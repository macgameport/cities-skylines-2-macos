+/* Cross-process remote layers for DXMT, reached by dlsym() on the two DECLSPEC_EXPORT symbols
+ * below rather than through a macdrv_functions_t member: that struct is C_ASSERT-ed at a fixed
+ * size, so adding a member is a breaking ABI change, while a standalone symbol degrades to a
+ * NULL dlsym. Surfaces are keyed by the view handed to DXMT, not by HWND: the same HWND is
+ * re-acquired several times, and retiring on acquire would destroy a layer still in use. */
+static pthread_mutex_t remote_layer_mutex = PTHREAD_MUTEX_INITIALIZER;
+static CFMutableDictionaryRef remote_layer_surfaces;   /* view -> client_surface DXMT still uses */
+
+/* One retired surface held per child HWND, not one globally. CAContextSwapChain's dealloc
+ * releases the remote CAContext, so deferring the client_surface release is the only thing that
+ * keeps a context alive across a recreate; keyed by child, it survives until that child's next
+ * release, which follows its successor's acquire. A destroyed child never releases again, so a
+ * release whose child is gone is not parked, and every release sweeps out dead slots. */
+static CFMutableDictionaryRef pending_by_child;        /* child HWND -> retired client_surface */
+
+static macdrv_metal_layer my_dxmt_acquire_remote_layer(HWND hwnd, macdrv_view *ret_view)
+{
+    struct client_surface *client;
+    struct macdrv_client_surface *surface;
+
+    if (ret_view) *ret_view = NULL;
+    if (!(client = macdrv_CreateClientSurface(hwnd, 0))) return NULL;
+    surface = impl_from_client_surface(client);
+
+    if (!macdrv_client_surface_acquire_metal_swapchain(surface))
+    {
+        ERR("dxmt: acquire_metal_swapchain FAILED for hwnd %p\n", hwnd);
+        client_surface_release(client);
+        return NULL;
+    }
+
+    TRACE("dxmt-life: remote layer acquired for hwnd %p (swapchain %p)\n", hwnd,
+          surface->metal_swapchain);
+    if (ret_view) *ret_view = surface->cocoa_view;
+
+    pthread_mutex_lock(&remote_layer_mutex);
+    if (!remote_layer_surfaces)
+        remote_layer_surfaces = CFDictionaryCreateMutable(NULL, 0, NULL, NULL);
+    if (remote_layer_surfaces && surface->cocoa_view)
+        CFDictionarySetValue(remote_layer_surfaces, surface->cocoa_view, client);
+    pthread_mutex_unlock(&remote_layer_mutex);
+
+    return macdrv_swapchain_get_layer(surface->metal_swapchain);
+}
+
+/* Remove every held surface whose child window no longer exists, for release outside the lock.
+ * Called with remote_layer_mutex held; at most `max` per call, the rest on the next release. */
+static CFIndex collect_dead_pending(struct client_surface **out, CFIndex max)
+{
+    CFIndex count, i, n = 0;
+    const void **keys, **vals;
+
+    if (!pending_by_child || !(count = CFDictionaryGetCount(pending_by_child))) return 0;
+    keys = calloc(count, sizeof(*keys));
+    vals = calloc(count, sizeof(*vals));
+    if (!keys || !vals) { free(keys); free(vals); return 0; }
+    CFDictionaryGetKeysAndValues(pending_by_child, keys, vals);
+    for (i = 0; i < count && n < max; i++)
+    {
+        if (NtUserIsWindow((HWND)keys[i])) continue;
+        out[n++] = (struct client_surface *)vals[i];
+        CFDictionaryRemoveValue(pending_by_child, keys[i]);
+    }
+    free(keys);
+    free(vals);
+    return n;
+}
+
+/* Retire the surface behind a view DXMT is finished with; TRUE if the view was one of ours, so
+ * DXMT falls through to the ordinary metal-view release when it was not. The release is deferred
+ * by one: releasing at once un-hosts the layer immediately, and a client that resizes by
+ * destroying a swapchain and creating a new one has nothing hosted between the two. */
+DECLSPEC_EXPORT BOOL dxmt_release_remote_layer(macdrv_view view)
+{
+    struct client_surface *client = NULL, *drain = NULL;
+    struct client_surface *dead[16];
+    CFIndex ndead, i;
+    HWND owner;
+
+    if (!view) return FALSE;
+
+    pthread_mutex_lock(&remote_layer_mutex);
+    if (remote_layer_surfaces)
+    {
+        client = (struct client_surface *)CFDictionaryGetValue(remote_layer_surfaces, view);
+        if (client) CFDictionaryRemoveValue(remote_layer_surfaces, view);
+    }
+    pthread_mutex_unlock(&remote_layer_mutex);
+
+    if (!client)
+    {
+        /* the normal case for every same-process metal view: not ours, DXMT releases it itself */
+        TRACE("dxmt-life: view %p is not a remote surface\n", view);
+        return FALSE;
+    }
+
+    owner = client->hwnd;
+    pthread_mutex_lock(&remote_layer_mutex);
+    if (!pending_by_child)
+        pending_by_child = CFDictionaryCreateMutable(NULL, 0, NULL, NULL);
+    if (!pending_by_child || !NtUserIsWindow(owner))
+    {
+        /* no table, or the child is already gone and no successor will ever come: release now */
+        drain = client;
+    }
+    else
+    {
+        drain = (struct client_surface *)CFDictionaryGetValue(pending_by_child, owner);
+        CFDictionarySetValue(pending_by_child, owner, client);
+    }
+    ndead = collect_dead_pending(dead, ARRAY_SIZE(dead));
+    pthread_mutex_unlock(&remote_layer_mutex);
+
+    TRACE("dxmt-life: release view %p child %p -- %s; draining %p and %ld dead-child slot(s)\n",
+          view, owner, drain == client ? "child gone, released now" : "held", drain, (long)ndead);
+    if (drain) client_surface_release(drain);
+    for (i = 0; i < ndead; i++) client_surface_release(dead[i]);
+    return TRUE;
+}
+
+DECLSPEC_EXPORT macdrv_metal_layer dxmt_acquire_remote_layer(HWND hwnd, macdrv_view *ret_view)
+{
+    return my_dxmt_acquire_remote_layer(hwnd, ret_view);
+}
