+/* Win32 speaks raw pixels and Cocoa points -- two to one on retina -- so an odd pixel dimension
+ * is a half point, and a layer that Win32 says reaches the window edge stops one device pixel
+ * short of it, showing the window beneath as a white hairline. Snapped only at the edge, so an
+ * interior sibling keeps its exact geometry and two widgets can never be made to overlap. */
+static CGRect snap_host_frame_to_view_edges(CGRect frame, CGRect view)
+{
+    /* one device pixel in points; a fixed 1.0 would also close a gap the app asked for */
+    const CGFloat px = retina_on ? 0.5 : 1.0;
+
+    if (CGRectIsEmpty(frame) || CGRectIsEmpty(view)) return frame;
+
+    if (frame.origin.x > 0.0 && frame.origin.x <= px)
+    {
+        frame.size.width += frame.origin.x;
+        frame.origin.x = 0.0;
+    }
+    if (frame.origin.y > 0.0 && frame.origin.y <= px)
+    {
+        frame.size.height += frame.origin.y;
+        frame.origin.y = 0.0;
+    }
+    if (CGRectGetMaxX(frame) >= view.size.width - px)
+        frame.size.width = view.size.width - frame.origin.x;
+    if (CGRectGetMaxY(frame) >= view.size.height - px)
+        frame.size.height = view.size.height - frame.origin.y;
+    return frame;
+}
