+/* Cross-process remote layers for DXMT (macgameport, 2026-08-29 .. 2026-09-02).
+ *
+ * DXMT reaches these through dlsym() on the two DECLSPEC_EXPORT symbols below, NOT through a
+ * macdrv_functions_t member: that struct is C_ASSERT-ed at a fixed size, so adding a member is a
+ * breaking ABI change (a DXMT built against a larger struct would read past the end of an older
+ * winemac's and call whatever followed). A standalone symbol degrades safely -- dlsym returns
+ * NULL on any winemac without this patch and DXMT falls back to its old path.
+ *
+ * Surfaces are keyed by the VIEW handed to DXMT, not by HWND: DXMT re-acquires the same HWND
+ * several times (measured: 16 distinct windows, 4 acquires each), and retiring the previous
+ * surface on acquire destroys the layer DXMT is still rendering into. Keying by view lets
+ * dxmt_release_remote_layer() retire exactly the surface DXMT is finished with. */
+static pthread_mutex_t remote_layer_mutex = PTHREAD_MUTEX_INITIALIZER;
+static CFMutableDictionaryRef remote_layer_surfaces;   /* view -> client_surface DXMT still uses */
+
+/* One retired surface held PER CHILD HWND, not one globally.
+ *
+ * WHY THIS IS THE ONLY LEVER (measured 2026-08-31). CAContextSwapChain's dealloc releases the
+ * remote CAContext, so once a swapchain dies the CALayerHost mirroring it has nothing to show --
+ * keeping the host alive on the owner side cannot help. Deferring the client_surface release is
+ * what keeps the CONTEXT alive across a recreate, and it is the only thing that does.
+ *
+ * A single global slot was not enough: with two browsers churning, browser A's release drained
+ * browser B's held context early and B's content blinked out. Measured -- retire-on-create alone
+ * took the gap rate from 2/40 (5.0%) to 2/160 (1.25%); the residual frames all carry the same
+ * signature, chrome perfect with a black content area.
+ *
+ * Keyed by the child HWND the surface belongs to, the previous context survives until the NEXT
+ * release FOR THAT SAME CHILD, which by construction happens after its successor was acquired.
+ *
+ * A child that is DESTROYED never releases again, so its slot would be held forever (found by
+ * review 2026-09-02: every closed popup menu parked one swapchain). Two guards close that: a
+ * release whose child is already gone is not parked at all, and every release sweeps the table
+ * for slots whose child has since died. */
+static CFMutableDictionaryRef pending_by_child;        /* child HWND -> retired client_surface */
+
+static macdrv_metal_layer my_dxmt_acquire_remote_layer(HWND hwnd, macdrv_view *ret_view)
+{
+    struct client_surface *client;
+    struct macdrv_client_surface *surface;
+
+    if (ret_view) *ret_view = NULL;
+    if (!(client = macdrv_CreateClientSurface(hwnd, 0))) return NULL;
+    surface = impl_from_client_surface(client);
+
+    if (!macdrv_client_surface_acquire_metal_swapchain(surface))
+    {
+        ERR("dxmt: acquire_metal_swapchain FAILED for hwnd %p\n", hwnd);
+        client_surface_release(client);
+        return NULL;
+    }
+
+    TRACE("dxmt-life: remote layer acquired for hwnd %p (swapchain %p)\n", hwnd,
+          surface->metal_swapchain);
+    if (ret_view) *ret_view = surface->cocoa_view;
+
+    pthread_mutex_lock(&remote_layer_mutex);
+    if (!remote_layer_surfaces)
+        remote_layer_surfaces = CFDictionaryCreateMutable(NULL, 0, NULL, NULL);
+    if (remote_layer_surfaces && surface->cocoa_view)
+        CFDictionarySetValue(remote_layer_surfaces, surface->cocoa_view, client);
+    pthread_mutex_unlock(&remote_layer_mutex);
+
+    return macdrv_swapchain_get_layer(surface->metal_swapchain);
+}
+
+/* Remove every held surface whose child window no longer exists, handing them back for release
+ * OUTSIDE the lock. Called with remote_layer_mutex held. At most `max` per call: anything left
+ * over is collected on the next release, so the bound delays a drain rather than dropping it. */
+static CFIndex collect_dead_pending(struct client_surface **out, CFIndex max)
+{
+    CFIndex count, i, n = 0;
+    const void **keys, **vals;
+
+    if (!pending_by_child || !(count = CFDictionaryGetCount(pending_by_child))) return 0;
+    keys = calloc(count, sizeof(*keys));
+    vals = calloc(count, sizeof(*vals));
+    if (!keys || !vals) { free(keys); free(vals); return 0; }
+    CFDictionaryGetKeysAndValues(pending_by_child, keys, vals);
+    for (i = 0; i < count && n < max; i++)
+    {
+        if (NtUserIsWindow((HWND)keys[i])) continue;
+        out[n++] = (struct client_surface *)vals[i];
+        CFDictionaryRemoveValue(pending_by_child, keys[i]);
+    }
+    free(keys);
+    free(vals);
+    return n;
+}
+
+/* Retire the surface behind a view DXMT is finished with. Returns TRUE if the view was one of
+ * ours, so DXMT can fall through to the ordinary metal-view release when it was not -- no tagging
+ * or bookkeeping needed on the DXMT side.
+ *
+ * DEFERRED BY ONE (2026-08-31). Releasing immediately deallocs the CAContextSwapChain and posts
+ * WM_MACDRV_RELEASE_REMOTE_LAYER, un-hosting the layer at once. CEF resizes by DESTROYING a
+ * swapchain and CREATING a new one, so an immediate release leaves a window with nothing hosted
+ * between the two -- seen live as flicker on resize, and as a permanent black child when the
+ * ordering is unlucky. Holding exactly ONE retired surface per child until that child's next
+ * release keeps something hosted across the gap while bounding the cost. */
+DECLSPEC_EXPORT BOOL dxmt_release_remote_layer(macdrv_view view)
+{
+    struct client_surface *client = NULL, *drain = NULL;
+    struct client_surface *dead[16];
+    CFIndex ndead, i;
+    HWND owner;
+
+    if (!view) return FALSE;
+
+    pthread_mutex_lock(&remote_layer_mutex);
+    if (remote_layer_surfaces)
+    {
+        client = (struct client_surface *)CFDictionaryGetValue(remote_layer_surfaces, view);
+        if (client) CFDictionaryRemoveValue(remote_layer_surfaces, view);
+    }
+    pthread_mutex_unlock(&remote_layer_mutex);
+
+    if (!client)
+    {
+        /* the normal case for every same-process metal view: not ours, DXMT releases it itself */
+        TRACE("dxmt-life: view %p is not a remote surface\n", view);
+        return FALSE;
+    }
+
+    owner = client->hwnd;
+    pthread_mutex_lock(&remote_layer_mutex);
+    if (!pending_by_child)
+        pending_by_child = CFDictionaryCreateMutable(NULL, 0, NULL, NULL);
+    if (!pending_by_child || !NtUserIsWindow(owner))
+    {
+        /* no table, or the child is already gone and no successor will ever come: release now */
+        drain = client;
+    }
+    else
+    {
+        drain = (struct client_surface *)CFDictionaryGetValue(pending_by_child, owner);
+        CFDictionarySetValue(pending_by_child, owner, client);
+    }
+    ndead = collect_dead_pending(dead, ARRAY_SIZE(dead));
+    pthread_mutex_unlock(&remote_layer_mutex);
+
+    TRACE("dxmt-life: release view %p child %p -- %s; draining %p and %ld dead-child slot(s)\n",
+          view, owner, drain == client ? "child gone, released now" : "held", drain, (long)ndead);
+    if (drain) client_surface_release(drain);
+    for (i = 0; i < ndead; i++) client_surface_release(dead[i]);
+    return TRUE;
+}
+
+DECLSPEC_EXPORT macdrv_metal_layer dxmt_acquire_remote_layer(HWND hwnd, macdrv_view *ret_view)
+{
+    return my_dxmt_acquire_remote_layer(hwnd, ret_view);
+}
