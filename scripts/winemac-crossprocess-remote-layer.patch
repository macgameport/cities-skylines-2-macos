+/* Resize an existing offscreen swapchain. CAContextSwapChain sets its layer bounds ONCE at init
+ * and the API had no way to change them.
+ *
+ * MEASURED DEAD, 2026-08-31. This function has NEVER been observed to execute: its only caller
+ * is macdrv_client_surface_update()'s remote-layer branch, and across five instrumented Steam
+ * sessions (resize-diag, -fix, -final, -ship, and the popup runs) that branch logged ZERO firings
+ * while HOST create/update logged hundreds. CEF resizes by DESTROYING and RECREATING the
+ * swapchain, so a new CAContextSwapChain is built at the new size and this path is never needed.
+ * The commit that added it claimed it fixed "stale strips of old content, black boxes in a corner,
+ * and sometimes a wholly black content area" -- that claim is WITHDRAWN. Whatever improved in that
+ * build came from the two changes beside it (root-relative child rect, Win32-px -> Cocoa-points).
+ * Kept rather than deleted because it is correct in principle and would be needed by any client
+ * that resizes a swapchain in place; but do not attribute any observed behaviour to it without
+ * seeing it log. (macgameport) */
+void macdrv_swapchain_set_bounds(macdrv_metal_swapchain swapchain, CGRect bounds)
+{
+@autoreleasepool
+{
+    id<WineMetalSwapChain> sc = (id<WineMetalSwapChain>)swapchain;
+    CALayer* layer;
+    CGRect want = cgrect_mac_from_win(bounds);
+
+    /* only an offscreen (CAContext) swapchain owns its layer's geometry; a view-backed one is
+     * sized by its view and must not be resized from here */
+    if (![(id)sc isKindOfClass:[CAContextSwapChain class]]) return;
+    layer = (CALayer*)[sc layer];
+    if (!layer || CGRectIsEmpty(want)) return;
+    OnMainThread(^{
+#ifdef DXMT_RSZ_DEBUG
+        {
+            BOOL isML = [layer isKindOfClass:[CAMetalLayer class]];
+            CGSize dw = isML ? ((CAMetalLayer*)layer).drawableSize : CGSizeZero;
+            CGFloat scale = layer.contentsScale;
+            double sx = want.size.width > 0 ? dw.width / (want.size.width * scale) : 0.0;
+            double sy = want.size.height > 0 ? dw.height / (want.size.height * scale) : 0.0;
+            BOOL stretched = dw.width != want.size.width * scale ||
+                             dw.height != want.size.height * scale;
+            /* SCALE = what the compositor must do to fit the presented drawable into the bounds we
+             * are setting. Anything other than 1.000 means the layer is being STRETCHED this frame,
+             * and with kCAFilterNearest a stretched photographic background shimmers while flat UI
+             * and text stay crisp -- which is the reported symptom exactly. */
+            DXMT_RSZ("CONTENT  set_bounds win=%.0fx%.0f -> pts=%.1fx%.1f (was %.1fx%.1f, "
+                     "drawable %.0fx%.0f) SCALE %.4f x %.4f%s\n",
+                     bounds.size.width, bounds.size.height, want.size.width, want.size.height,
+                     layer.bounds.size.width, layer.bounds.size.height, dw.width, dw.height,
+                     sx, sy, stretched ? "   <== STRETCHED" : "");
+        }
+#endif
+        if (!CGRectEqualToRect(layer.bounds, CGRectMake(0, 0, want.size.width, want.size.height)))
+        {
+            [CATransaction begin];
+            [CATransaction setDisableActions:YES];
+            [layer setBounds:CGRectMake(0, 0, want.size.width, want.size.height)];
+            [CATransaction commit];
+        }
+    });
+}
