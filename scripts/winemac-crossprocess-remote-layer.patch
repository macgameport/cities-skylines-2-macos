+/* ---- RESIZE DIAGNOSTIC -- off unless built with -DDXMT_RSZ_DEBUG (2026-08-31, macgameport) ----
+ * The host frame (owner process) and the hosted layer's size (GPU process) are maintained by two
+ * DIFFERENT processes through two independent paths. This prints both sides plus the resulting
+ * z-order on a common wall clock, which is how the half-point hairline and the z-order blackout
+ * were both identified. Kept, not deleted: the measurements are only reproducible with it.
+ * fprintf rather than ERR() so a WINEDEBUG channel setting cannot filter it away. */
+#ifdef DXMT_RSZ_DEBUG
+static double dxmt_rsz_ms(void)
+{
+    struct timeval tv;
+    gettimeofday(&tv, NULL);
+    return (double)(tv.tv_sec % 1000) * 1000.0 + tv.tv_usec / 1000.0;
+}
+#define DXMT_RSZ(fmt, ...) fprintf(stderr, "dxmt-rsz: %8.1f pid=%-5d " fmt, \
+                                   dxmt_rsz_ms(), (int)getpid(), ## __VA_ARGS__)
+#else
+#define DXMT_RSZ(fmt, ...) do { } while (0)
+#endif
+
+/* Win32 speaks RAW PIXELS; Cocoa speaks POINTS, and on a retina display that is a factor of two.
+ * An ODD pixel dimension therefore converts to a HALF point -- and because the NSWindow's content
+ * view is sized in whole points, a layer that Win32 says reaches the window edge stops exactly ONE
+ * DEVICE PIXEL short of it. The window beneath shows through as a white hairline down the right
+ * edge (odd width) and along the bottom (odd height).
+ *
+ * Measured 2026-08-31: root 2401x1500 px -> host frame 1200.5x750.0 pt inside a 1201.0x750.0 pt
+ * view -> column x=2401 reads 255,255,255 against an interior of 15,25,36. Even sizes show
+ * nothing, and the axis that is odd is the axis that shows it.
+ *
+ * Extend to the view's edge, and ONLY at the edge: an interior sibling keeps its exact geometry,
+ * so this cannot make two widgets overlap. On a non-retina display the threshold is a whole
+ * point, which is still one device pixel. */
+static CGRect dxmt_fill_view_edges(CGRect frame, CGRect view)
+{
+    /* The quantity that matters is ONE DEVICE PIXEL expressed in points -- 0.5 on retina, 1.0
+     * otherwise. Hardcoding 1.0 (the first version) is correct only on the display it was tested
+     * on: on retina it also snaps rects a whole point from the edge, closing a two-device-pixel
+     * gap the app may have asked for. */
+    const CGFloat px = retina_on ? 0.5 : 1.0;
+
+    if (CGRectIsEmpty(frame) || CGRectIsEmpty(view)) return frame;
+
+    if (frame.origin.x > 0.0 && frame.origin.x <= px)
+    {
+        frame.size.width += frame.origin.x;
+        frame.origin.x = 0.0;
+    }
+    if (frame.origin.y > 0.0 && frame.origin.y <= px)
+    {
+        frame.size.height += frame.origin.y;
+        frame.origin.y = 0.0;
+    }
+    if (CGRectGetMaxX(frame) >= view.size.width - px)
+        frame.size.width = view.size.width - frame.origin.x;
+    if (CGRectGetMaxY(frame) >= view.size.height - px)
+        frame.size.height = view.size.height - frame.origin.y;
+    return frame;
+}
