+/* Win32 paint order for the hosted children of one root. Higher index = nearer the viewer.
+ *
+ * Steam's client is TWO SIBLING CefBrowserWindow trees on one root -- measured 2026-08-31:
+ *     root 0x30124 SDL_app
+ *       +- 0x1013E CefBrowserWindow 2398x1215 @1,250   (TOP sibling)    -> hosts 0x10140
+ *       +- 0x6012A CefBrowserWindow 2400x1500 @0,66    (BOTTOM sibling) -> hosts 0x2011E
+ * and the hosted layers used to be stacked in the order they were CREATED. CEF recreates a
+ * swapchain on every resize, so a resize that recreated the LOWER browser's surface put it on top
+ * of the upper one and the client went black -- and stayed black.
+ *
+ * Siblings are walked BOTTOM to TOP (GW_HWNDNEXT runs top to bottom) and a window is recorded
+ * before its own children, so a child sits above its parent and an upper sibling sits above the
+ * whole subtree of a lower one. That is what Win32 painting does.
+ *
+ * COMPUTE THIS ONCE PER UPDATE, NOT ONCE PER LAYER. The first version walked the entire tree
+ * inside update_remote_layer_frames()'s per-layer loop, so a window with N hosted layers cost N
+ * full tree walks -- every NtUserGetWindowRelative a syscall -- on a path that fires continuously
+ * while a window is being dragged. */
+#define PAINT_ORDER_MAX 64
+#define PAINT_ORDER_DEPTH 8
 
+struct paint_order
+{
+    HWND hwnds[PAINT_ORDER_MAX];   /* index 0 = furthest back */
+    int  count;
+    BOOL truncated;                /* a bound was hit; z-order below is incomplete */
+};
+
+/* Never silently: an unlogged cap reads as "we ordered everything" when we did not. Once per
+ * process, though -- this runs on the drag path. Layers past the cap keep their previous z. */
+static void paint_order_truncated(struct paint_order *po, const char *why, HWND at)
+{
+    static BOOL warned;
+
+    if (!warned)
+    {
+        FIXME("%s below %p -- paint order incomplete, hosted layers past the cap keep their z\n",
+              why, at);
+        warned = TRUE;
+    }
+    po->truncated = TRUE;
+}
+
+static void paint_order_walk(HWND parent, struct paint_order *po, int depth)
+{
+    HWND kids[PAINT_ORDER_MAX];
+    HWND k;
+    int n = 0, i;
+
+    if (depth >= PAINT_ORDER_DEPTH)
+    {
+        paint_order_truncated(po, "window tree too deep", parent);
+        return;
+    }
+
+    for (k = NtUserGetWindowRelative(parent, GW_CHILD); k;
+         k = NtUserGetWindowRelative(k, GW_HWNDNEXT))
+    {
+        if (n == PAINT_ORDER_MAX)
+        {
+            paint_order_truncated(po, "too many siblings", parent);
+            break;
+        }
+        kids[n++] = k;
+    }
+
+    for (i = n - 1; i >= 0; i--)
+    {
+        if (po->count == PAINT_ORDER_MAX)
+        {
+            paint_order_truncated(po, "too many windows in the tree", parent);
+            return;
+        }
+        po->hwnds[po->count++] = kids[i];
+        paint_order_walk(kids[i], po, depth + 1);
+    }
+}
+
+static void build_paint_order(HWND root, struct paint_order *po)
+{
+    po->count = 0;
+    po->truncated = FALSE;
+    if (root) paint_order_walk(root, po, 0);
+}
+
+/* TRUE + *zpos on success. On failure the caller must leave zPosition ALONE -- returning 0.0 would
+ * be indistinguishable from a legitimate bottom-most position, which is how a lookup miss would
+ * silently slam a layer to the back of the stack. */
+static BOOL paint_order_zpos(const struct paint_order *po, HWND child, double *zpos)
+{
+    int i;
+
+    for (i = 0; i < po->count; i++)
+        if (po->hwnds[i] == child) { *zpos = (double)(i + 1); return TRUE; }
+    return FALSE;
+}
