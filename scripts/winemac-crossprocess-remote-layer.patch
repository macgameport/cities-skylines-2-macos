+    {
+        CALayerHost* host = [_caLayerHosts objectForKey:@(contextId)];
+        frame = dxmt_fill_view_edges(frame, self.layer.bounds);
+        DXMT_RSZ("HOST     update  ctx=%u frame=%.1f,%.1f %.1fx%.1f  (was %.1f,%.1f %.1fx%.1f%s)\n",
+                 (unsigned)contextId, frame.origin.x, frame.origin.y,
+                 frame.size.width, frame.size.height,
+                 host ? host.frame.origin.x : -1.0, host ? host.frame.origin.y : -1.0,
+                 host ? host.frame.size.width : -1.0, host ? host.frame.size.height : -1.0,
+                 host ? "" : " NO-HOST");
+        if (host && CGRectIsEmpty(frame) && !CGRectIsNull(frame))
+        {
+            /* Became 0x0 while hosted. Skipping this (what the code did before 2026-08-31) leaves
+             * the layer at its last full size, still covering live content -- the same blackout as
+             * the create path above, reached by a different route.
+             * Zero the frame as well as hiding: it is the second half of the safety net below. */
+            [CATransaction begin];
+            [CATransaction setDisableActions:YES];
+            host.hidden = YES;
+            host.frame = CGRectZero;
+            [CATransaction commit];
+        }
+        else if (host && !CGRectIsEmpty(frame))
+        {
+            /* The hosted layer is positioned in the OWNER's coordinate space; the child it mirrors
+             * lives in another process and can move or resize after the layer was hosted, so
+             * refresh it rather than leaving a stale frame.
+             *
+             * WARNING: UN-HIDING MUST NOT BE GATED ON THE FRAME HAVING CHANGED (2026-08-31).
+             * It was, for about an hour, and it black-holed Steam's Friends List every time:
+             *     create ctx=1274046919 frame 300.0x650.0
+             *     update frame 0.0x0.0   -> hidden          (window briefly reports 0x0)
+             *     update frame 300.0x650.0 (was 300.0x650.0) -> EQUAL, so the whole branch was
+             *                                                   skipped and hidden stayed YES
+             * The frame came back to a value it already held, so a `!CGRectEqualToRect` guard on
+             * the entire branch never ran and the layer stayed hidden forever. Visibility and
+             * geometry are independent pieces of state; test each one separately. */
+            [CATransaction begin];
+            [CATransaction setDisableActions:YES];
+            if (!CGRectEqualToRect(host.frame, frame)) host.frame = frame;
+            if (host.hidden) host.hidden = NO;
+            [CATransaction commit];
+        }
+    }
