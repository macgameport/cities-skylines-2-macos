# dxmt-nullcheck-win-data.patch — SUPERSEDED, kept for the record.
# Six lines null-checking get_win_data() before the dereference. It removes the crash but does
# NOT fix the black window: the caller aborts on a null view by design, so the fault simply
# moves to __wine_unix_call_dispatcher. Use the remote-layer pair instead.
#
# ⚠ AI-AUTHORED. Read this before you read the code.
#
# This patch was written with heavy AI assistance. 3Shain/dxmt's CONTRIBUTING.md cannot accept
# AI-authored contributions, so it was never offered as a PR — the findings went upstream as a
# report instead: https://github.com/3Shain/dxmt/issues/141#issuecomment-5477055980
#
# It is published here on purpose: this is our port's own record, and anyone should be able to
# find it.
#
# It is MIT-licensed like the rest of this repo, so you are welcome to use, adapt or rewrite it
# under those terms. Nothing is expected back and there is no need to ask first.
#
# But if you are a dxmt or wine maintainer who intends to write your own implementation,
# reading this file is a choice with a consequence — afterwards you cannot cleanly say your work
# is AI-free. The issue comment above carries the whole diagnosis (mechanism, faulting
# instruction, measurements, falsification tests) with none of the code, which is the version
# you probably want.
#
diff --git a/src/winemetal/unix/winemetal_unix.c b/src/winemetal/unix/winemetal_unix.c
index 4744692..c25be54 100644
--- a/src/winemetal/unix/winemetal_unix.c
+++ b/src/winemetal/unix/winemetal_unix.c
@@ -1,5 +1,6 @@
 #include <stdatomic.h>
 #include <dlfcn.h>
+#include <stdio.h>
 #import <Cocoa/Cocoa.h>
 #import <ColorSync/ColorSync.h>
 #import <CoreFoundation/CFRunLoop.h>
@@ -1597,13 +1598,40 @@ _CreateMetalViewFromHWND(void *obj) {
   if (pfn_get_win_data && pfn_release_win_data && pfn_macdrv_view_create_metal_view &&
       pfn_macdrv_view_get_metal_layer) {
     struct macdrv_win_data *win_data = pfn_get_win_data((HWND)params->hwnd);
-    macdrv_metal_view view =
-        pfn_macdrv_view_create_metal_view(win_data->client_cocoa_view, (macdrv_metal_device)params->device);
-    params->ret_view = (obj_handle_t)view;
-    if (view) {
-      params->ret_layer = (obj_handle_t)pfn_macdrv_view_get_metal_layer(view);
+    /* DIAGNOSTIC (2026-08-31): the d3d11 CreateSwapChain cross-process guard did NOT fire for this
+     * call, so GetWindowThreadProcessId() says the window is OURS -- yet get_win_data() still
+     * returns NULL. Find out what kind of window it actually is. The load-bearing question is the
+     * last one: if the ROOT resolves and the passed HWND does not, this is the child-window case
+     * and the fix is to map child -> root, not to bail out. */
+    if (!win_data) {
+      HWND h = (HWND)params->hwnd;
+      /* NtUserGetAncestor is not declared unix-side; resolve it the same way as everything else
+         here. GA_PARENT=1, GA_ROOT=2 (winuser.h). */
+      HWND (*pfn_ancestor)(HWND, unsigned int) = dlsym(RTLD_DEFAULT, "NtUserGetAncestor");
+      HWND parent = pfn_ancestor ? pfn_ancestor(h, 1) : NULL;
+      HWND root   = pfn_ancestor ? pfn_ancestor(h, 2) : NULL;
+      struct macdrv_win_data *root_data = (root && root != h) ? pfn_get_win_data(root) : NULL;
+      fprintf(stderr,
+              "dxmt-diag: get_win_data(%p) NULL  parent=%p root=%p  root_win_data=%s\n",
+              h, parent, root, root_data ? "PRESENT" : "null");
+      if (root_data)
+        pfn_release_win_data(root_data);
+    }
+    /* get_win_data() returns NULL for an HWND owned by ANOTHER PROCESS: winemac keeps win_datas in
+     * a process-local CFDictionary, so a foreign window is invisible by construction. Steam's CEF
+     * GPU process asks for a Metal view for the BROWSER process's HWND, so this is not a rare
+     * edge -- it is the normal path there, and the unchecked win_data->client_cocoa_view below
+     * dereferenced NULL at +0x18, aborted the GPU process, and Chromium gave up after 6 retries.
+     * Fail the call instead; the caller already handles a zero ret_view. */
+    if (win_data) {
+      macdrv_metal_view view =
+          pfn_macdrv_view_create_metal_view(win_data->client_cocoa_view, (macdrv_metal_device)params->device);
+      params->ret_view = (obj_handle_t)view;
+      if (view) {
+        params->ret_layer = (obj_handle_t)pfn_macdrv_view_get_metal_layer(view);
+      }
+      pfn_release_win_data(win_data);
     }
-    pfn_release_win_data(win_data);
   }
 
   return STATUS_SUCCESS;
