*.png
!docs/images/*.png
!docs/images/*.jpg
*.jpg
*.jpeg
login*.png
qr*.png

# --- game / wine artifacts (large, machine-specific, or copyrighted) ---
*.dll
*.exe
*.bak
*.coc
*.dxvk-cache
*.dmp
dumps/
Player.log
*.log
prefix/
Bottles/

# --- build / tooling ---
revenv/
scratchpad/
__pycache__/
*.pyc
.venv/
venv/

